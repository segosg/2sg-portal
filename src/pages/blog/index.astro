---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => data.status === 'published');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d) => d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title="Blog">
  <Nav slot="nav" />
  <section class="max-w-3xl mx-auto px-6 pt-32 pb-24">
    <p class="font-mono text-forge-secondary text-sm mb-4">~/blog</p>
    <h1 class="font-mono text-4xl font-bold text-forge-heading mb-12">Blog</h1>

    {posts.length === 0 && (
      <p class="text-forge-body font-sans">— Aucun article publié pour le moment.</p>
    )}

    <ul class="space-y-8">
      {posts.map((post) => (
        <li class="border-b border-forge-border pb-8">
          <a href={`/blog/${post.slug}`} class="group block">
            <p class="font-mono text-xs text-forge-muted mb-3">{formatDate(post.data.date)}</p>
            <h2 class="font-mono text-2xl font-bold text-forge-heading mb-2 group-hover:text-forge-primary transition-colors duration-200">
              {post.data.title}
            </h2>
            {post.data.subtitle && (
              <p class="font-sans text-forge-body leading-relaxed">{post.data.subtitle}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
  <Footer slot="footer" />
</BaseLayout>